
from pathlib import Path
import subprocess
import sys
import pandas as pd

PROJECT_ROOT = Path(workflow.basedir).parent
INCOMING_DIR = PROJECT_ROOT / "data" / "incoming"
INGEST_SCRIPT = PROJECT_ROOT / "workflow" / "scripts" / "ingest.py"

# Lecture du registre des acquisitions
acquisitions = pd.read_csv(
    "config/acquisitions.tsv",
    sep="\t"
)

# Liste de toutes les sorties attendues
stacked_targets = [
    f"data/intermediate/stacked/{row.museum_id}/"
    f"{row.acquisition_date}/{row.camera_id}"
    for row in acquisitions.itertuples()
]

ocr_targets = [
    f"data/intermediate/ocr/{row.museum_id}/"
    f"{row.acquisition_date}/{row.camera_id}/labels.csv"
    for row in acquisitions.itertuples()
]

rule all:
    input:
        ocr_targets

rule ingest:
    output:
        touch("results/ingestion/.ingestion_complete")

    log:
        "logs/ingestion/snakemake.log"

    run:
        acquisition_folders = sorted(
            path for path in INCOMING_DIR.iterdir()
            if path.is_dir()
        ) if INCOMING_DIR.exists() else []

        if not acquisition_folders:
            print("Aucune acquisition à importer dans data/incoming.")

        else:
            print(f"{len(acquisition_folders)} acquisition(s) détectée(s).")

            for folder in acquisition_folders:
                print(f"Ingestion de : {folder.name}")

                subprocess.run(
                    [
                        sys.executable,
                        str(INGEST_SCRIPT),
                        "--project-root",
                        str(PROJECT_ROOT),
                        "--folder",
                        folder.name
                    ],
                    check=True
                )

rule select_stacked:
    input:
        raw_dir="data/raw/{museum}/{date}/{camera}"
    output:
        directory(
            "data/intermediate/stacked/{museum}/{date}/{camera}"
        )
    log:
        "logs/stacked/{museum}/{date}/{camera}.log"
    shell:
        """
        python workflow/scripts/select_stacked.py \
            --input-dir {input.raw_dir} \
            --output-dir {output} \
            > {log} 2>&1
        """


rule extract_labels:
    input:
        stacked_dir="data/intermediate/stacked/{museum}/{date}/{camera}"
    output:
        labels="data/intermediate/ocr/{museum}/{date}/{camera}/labels.csv"
    params:
        model="Models/DB_TD500_resnet18.onnx"
    log:
        "logs/ocr/{museum}/{date}/{camera}.log"
    threads: 1
    shell:
        """
        python workflow/scripts/extract_labels.py \
            --input-dir {input.stacked_dir:q} \
            --model {params.model:q} \
            --output-csv {output.labels:q} \
            > {log:q} 2>&1
        """

# Execution : snakemake ingest --cores 1 --force